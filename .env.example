# Copy to .env and fill in. .env is gitignored; never commit real secrets here.

# Postgres connection string (Prisma). Local dev uses the docker-compose db on host port 5433.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/portfolio"

# JWT signing secret. Generate: openssl rand -base64 48
JWT_SECRET="change-me"

# Key required on POST /auth/register (?key=) to create the admin. Not the login password.
ADMIN_PWD="change-me"

# CORS allowed origins, comma-separated.
TRUSTED_ORIGINS="http://localhost:3001"

# Port the API listens on.
APP_PORT=5000

# Next.js front URL. Backend POSTs revalidation to ${FRONT_URL}/api/revalidate.
FRONT_URL="http://localhost:3001"

# Shared secret for revalidation; must match the front's value.
REVALIDATE_SECRET="change-me"

# Alias sandbox tuning (optional, defaults shown).
ALIAS_EVAL_TIMEOUT_MS=50
ALIAS_EVAL_MAX_DEPTH=20
