generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum MediaType {
  IMAGE
  VIDEO
}

// Project nature categories (formerly QUAL tags). The value set mirrors the
// front's SORT_TYPE keys; a project's natures drive its sort buckets and its
// "type" label (Personnel/Scolaire/Web/Simulation). DATE/RANDOM are legacy sort
// directives kept so no historical assignment is lost.
enum ProjectNature {
  SCHOOL
  PERSONAL
  WEB
  SIMULATIONS
  DATE
  RANDOM
}

enum CompanyKind {
  EMPLOYER
  CLIENT
}

enum ContractType {
  Permanent
  Fixed
  Internship
  Workstudy
  Freelance
}

enum Locale {
  fr
  en
}

/**
 * ---------------- USERS ----------------
 */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

/**
 * ---------------- PROJECTS ----------------
 */

model Project {
  id             String               @id @default(cuid())
  startDate      DateTime
  endDate        DateTime?
  isVisible      Boolean
  gitUrl         String?
  visitUrl       String?
  playUrl        String?
  logoUrl        String?
  media          Media[]
  // Tech stack = skills (the unified technology entity; formerly TECH tags).
  skills         Skill[]              @relation("ProjectSkills")
  // Project nature(s) — formerly QUAL tags, now a scalar enum array.
  natures        ProjectNature[]
  // Optional cross-links to the blog. A project may point at a whole category
  // (« voir les articles ») and/or a single flagship article (« lire l'article »);
  // both independent + optional. onDelete SetNull so deleting the target just
  // clears the pointer (like Mission.clientCompanyId).
  blogCategoryId String?
  blogCategory   ArticleCategory?     @relation("ProjectBlogCategory", fields: [blogCategoryId], references: [id], onDelete: SetNull)
  blogArticleId  String?
  blogArticle    Article?             @relation("ProjectBlogArticle", fields: [blogArticleId], references: [id], onDelete: SetNull)
  translations   ProjectTranslation[]
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  locale      Locale
  name        String
  description String
  type        String?
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  @@unique([projectId, locale])
}

/**
 * ---------------- MEDIA ----------------
 */

// A Media row is an uploaded file record (mediaUrl = /uploads/<uuid>.ext),
// produced by POST /media. It is the shared upload mechanism: every owner that
// carries an image (Company.logoUrl, Skill.image, Mission.imageUrl, …) uploads
// through here and stores the returned path string directly on its own field —
// see docs/specs/unified-assets.md. Media rows optionally belong to a Project
// (the one owner that keeps a relation, for its N-image galleries).
model Media {
  id           String    @id @default(cuid())
  mediaUrl     String
  type         MediaType
  originalName String?
  mimeType     String?
  alt          String?
  order        Int       @default(0)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String?
}

/**
 * ---------------- SKILLS (the unified technology entity) ----------------
 */

// A Skill is the single representation of a technology/tool. It is shown in the
// public skills grid (with an icon + wiki link) AND used as the tech-stack tag
// on projects, missions, and employer cards. It absorbed the former TECH `Tag`
// pool — projects/missions/companies link here, and the chips can render as
// links via `wikiUrl`.
model Skill {
  id            String             @id @default(cuid())
  image         String? // SVG/logo — nullable: skills migrated from tags have none yet
  wikiUrl       String?
  isVisible     Boolean
  categoryLinks SkillOnCategory[]
  translations  SkillTranslation[]
  // Tech-stack usages (formerly Tag relations).
  projects      Project[]          @relation("ProjectSkills")
  missions      Mission[]          @relation("MissionSkills")
  companies     Company[]          @relation("CompanySkills")
}

model SkillTranslation {
  id      String @id @default(cuid())
  locale  Locale
  name    String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String

  @@unique([skillId, locale])
}

/**
 * ---------------- SKILL CATEGORIES ----------------
 */

model SkillCategory {
  id           String                     @id @default(cuid())
  isVisible    Boolean
  order        Int                        @default(0)
  skillLinks   SkillOnCategory[]
  translations SkillCategoryTranslation[]
}

// Explicit join between Skill and SkillCategory carrying the per-category
// display order of a skill (same skill can sit at a different position in each
// category). Replaces the previous implicit m2m relation "SkillToCategory".
model SkillOnCategory {
  skill      Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  order      Int           @default(0)

  @@id([skillId, categoryId])
  @@index([categoryId])
}

model SkillCategoryTranslation {
  id              String        @id @default(cuid())
  locale          Locale
  name            String
  skillCategory   SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  skillCategoryId String

  @@unique([skillCategoryId, locale])
}

/**
 * ---------------- BLOG: ARTICLES & CATEGORIES ----------------
 */

// A blog article / experience-report. The body is Markdown (GFM + directives),
// rendered server-side at ISR time on the public /blog/[slug] page. Locale-
// independent fields (slug, visibility, dates, cover, tags, order) live here;
// the translatable title/excerpt/body live in ArticleTranslation.
// isVisible defaults false: an article stays a draft until explicitly published,
// so writing one never exposes it. publishedAt is editable and drives the public
// DESC ordering (the service backfills it to now() on first publish).
model Article {
  id             String               @id @default(cuid())
  slug           String               @unique
  isVisible      Boolean              @default(false)
  publishedAt    DateTime?
  // Private review link. Non-null = the article is reachable at
  // /blog/preview/<token> whatever isVisible says, so a draft can be sent out
  // for validation before it goes public. Orthogonal to isVisible; rotating or
  // clearing it revokes the link immediately. Never leaves a public endpoint.
  previewToken   String?              @unique
  coverImageUrl  String? // plain /uploads/... path or external URL (like Mission.imageUrl)
  tags           String[] // freeform metadata tags
  order          Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  categoryLinks  ArticleOnCategory[]
  translations   ArticleTranslation[]
  // Projects whose "lire l'article" link points here (Project.blogArticleId).
  linkedProjects Project[]            @relation("ProjectBlogArticle")

  @@index([publishedAt])
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  locale    Locale
  title     String
  excerpt   String // short summary shown on cards + used for OG/meta description
  body      String // Markdown source (Postgres text — no length cap)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@unique([articleId, locale])
}

// Managed taxonomy for filtering the public blog (e.g. "Wakfuli"). Slug drives
// the /blog?cat=<slug> filter; name is translatable. Follows the SkillCategory /
// SkillOnCategory join pattern so an article can sit in several categories.
model ArticleCategory {
  id             String                       @id @default(cuid())
  slug           String                       @unique
  isVisible      Boolean                      @default(true)
  order          Int                          @default(0)
  articleLinks   ArticleOnCategory[]
  translations   ArticleCategoryTranslation[]
  // Projects whose "voir les articles" link points at this category (Project.blogCategoryId).
  linkedProjects Project[]                    @relation("ProjectBlogCategory")
}

// Explicit join between Article and ArticleCategory carrying the per-category
// display order (mirrors SkillOnCategory). Written via Article.categoryLinks
// nested create — excluded from the snapshot scripts (NOT_SNAPSHOTTED).
model ArticleOnCategory {
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  String
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  order      Int             @default(0)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model ArticleCategoryTranslation {
  id                String          @id @default(cuid())
  locale            Locale
  name              String
  articleCategory   ArticleCategory @relation(fields: [articleCategoryId], references: [id], onDelete: Cascade)
  articleCategoryId String

  @@unique([articleCategoryId, locale])
}

/**
 * ---------------- TIMELINE: COMPANIES / MISSIONS / EDUCATION ----------------
 */

// A company is either the user's EMPLOYER (an ESN/consultancy carrying the
// long-term contract: contractType + employmentStart/End) or a CLIENT a mission
// was delivered for. Name/localisation are locale-independent proper nouns, but
// the editorial blurb (description) is translatable, so it lives in the sibling
// CompanyTranslation table.
model Company {
  id               String               @id @default(cuid())
  kind             CompanyKind
  name             String
  localisation     String?
  siteUrl          String?
  // Large illustration image (« fond ») shown on the public experience card.
  backgroundUrl    String?
  // The company's actual logo — used by the standalone timeline app, not the public site.
  logoUrl          String?
  isVisible        Boolean              @default(true)
  order            Int                  @default(0)
  // Employer-only — NULL when kind = CLIENT. employmentEnd NULL = current employer.
  contractType     ContractType?
  employmentStart  DateTime?
  employmentEnd    DateTime?
  // CLIENT-only: the employer this client was engaged through. NULL for EMPLOYER rows.
  parentEmployerId String?
  parentEmployer   Company?             @relation("CompanyClients", fields: [parentEmployerId], references: [id], onDelete: Cascade)
  clients          Company[]            @relation("CompanyClients")
  employerMissions Mission[]            @relation("MissionEmployer")
  clientMissions   Mission[]            @relation("MissionClient")
  // EMPLOYER-only: the job-title progression held at this employer over time.
  positions        Position[]
  // EMPLOYER-level curated skills shown on the public experience card. Separate
  // axis from per-mission skills so a company with many missions doesn't
  // surface an unbounded list on its card.
  skills           Skill[]              @relation("CompanySkills")
  // Per-locale editorial blurb shown on the public card (employer) or in the
  // mission modal (client). Optional: a company may have none.
  translations     CompanyTranslation[]
}

// Translatable editorial blurb for a Company, one row per supported locale.
model CompanyTranslation {
  id          String  @id @default(cuid())
  locale      Locale
  description String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String

  @@unique([companyId, locale])
}

// One engagement under an employer, optionally delivered for a client company.
model Mission {
  id                String               @id @default(cuid())
  employerCompany   Company              @relation("MissionEmployer", fields: [employerCompanyId], references: [id], onDelete: Cascade)
  employerCompanyId String
  clientCompany     Company?             @relation("MissionClient", fields: [clientCompanyId], references: [id], onDelete: SetNull)
  clientCompanyId   String?
  startDate         DateTime
  endDate           DateTime? // NULL = ongoing
  isVisible         Boolean              @default(true)
  order             Int                  @default(0)
  // Optional single illustration. A plain path/URL string (like Company.logoUrl
  // and Skill.image): an uploaded `/uploads/...` path, a static `public/` ref,
  // or an external URL. Resolved client-side via `mediaSrc`.
  imageUrl          String?
  skills            Skill[]              @relation("MissionSkills")
  translations      MissionTranslation[]
}

model MissionTranslation {
  id        String   @id @default(cuid())
  locale    Locale
  title     String
  context   String?
  tasks     String[] // ordered bullet points
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  @@unique([missionId, locale])
}

// A job-title held at an employer over a date range. Several positions under one
// employer express a title progression (e.g. Apprentice Dev → Engineer); a single
// position is the title for the whole tenure. Independent of client missions.
model Position {
  id           String                @id @default(cuid())
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  startDate    DateTime
  endDate      DateTime? // NULL = current position
  isVisible    Boolean               @default(true)
  order        Int                   @default(0)
  translations PositionTranslation[]
}

model PositionTranslation {
  id         String   @id @default(cuid())
  locale     Locale
  title      String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String

  @@unique([positionId, locale])
}

model Education {
  id              String                 @id @default(cuid())
  institutionName String
  startDate       DateTime
  endDate         DateTime?
  logoUrl         String?
  siteUrl         String?
  isVisible       Boolean                @default(true)
  order           Int                    @default(0)
  translations    EducationTranslation[]
}

model EducationTranslation {
  id          String    @id @default(cuid())
  locale      Locale
  degree      String
  description String?
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)
  educationId String

  @@unique([educationId, locale])
}

/**
 * ---------------- CONTACT ----------------
 */

model Contact {
  id           String               @id @default(cuid())
  contactUrl   String
  imageUrl     String
  isVisible    Boolean
  cssSize      String?
  translations ContactTranslation[]
}

model ContactTranslation {
  id        String  @id @default(cuid())
  locale    Locale
  name      String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([contactId, locale])
}

/**
 * ---------------- PROFILE ----------------
 */

model Profile {
  id           String               @id @default(cuid())
  name         String               @default("")
  imageUrl     String?
  updatedAt    DateTime             @updatedAt
  translations ProfileTranslation[]
}

model ProfileTranslation {
  id           String  @id @default(cuid())
  locale       Locale
  greeting     String  @default("")
  profession   String  @default("")
  description  String  @default("")
  skillsTitle  String  @default("")
  introduction String  @default("")
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String

  @@unique([profileId, locale])
}

/**
 * ---------------- RESUME ----------------
 */

model Resume {
  id           String              @id @default(cuid())
  updatedAt    DateTime            @updatedAt
  translations ResumeTranslation[]
}

model ResumeTranslation {
  id       String @id @default(cuid())
  locale   Locale
  url      String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String
}

/**
 * ---------------- CV GENERATION ----------------
 */

// Singleton config for the LaTeX CV generator. Distinct from `Resume` (the
// manually-uploaded public CV): this stores WHICH portfolio data the generator
// pulls (selection JSON) and WHERE the last generated PDFs live, so the
// back-office remembers the choice between sessions. There is one row (the
// service upserts the first/oldest). Generation reads existing content tables
// (Profile, Company, Mission, Position, Education, Skill, Contact, Project),
// renders a template, compiles with Tectonic, and writes a PDF under /uploads.
model CvConfig {
  id             String   @id @default(cuid())
  // Template key resolved against src/cv/latex/templates (e.g. "international").
  template       String   @default("international")
  // { sections: { experience, education, skills, projects, contact },
  //   includeIds: { companies, missions, education, skills, projects, contacts } }
  selection      Json
  // Last generated PDF per locale, as /uploads/<uuid>.pdf paths (served statically).
  generatedFrUrl String?
  generatedEnUrl String?
  updatedAt      DateTime @updatedAt
}

/**
 * ---------------- ALIAS (dynamic, per-locale JS bodies) ----------------
 */

model Alias {
  id        String      @id @default(cuid())
  key       String      @unique // "age", "example", "greeting", "email"
  bodies    AliasBody[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AliasBody {
  id      String @id @default(cuid())
  aliasId String
  locale  String // "fr", "en" — kept as String per the alias spec
  code    String // JS, last line = return
  alias   Alias  @relation(fields: [aliasId], references: [id], onDelete: Cascade)

  @@unique([aliasId, locale])
}
