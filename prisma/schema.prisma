generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TagType {
  TECH
  QUAL
  SKILL_CATEGORY
  EXPERIENCE_TECH
}

enum ContractType {
  Permanent
  Fixed
  Internship
  Workstudy
  Freelance
}

enum Locale {
  fr
  en
}

/* ---------------- USERS ---------------- */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

/* ---------------- PROJECTS ---------------- */

model Project {
  id          String    @id @default(cuid())
  date        DateTime
  isVisible   Boolean
  gitUrl      String?
  visitUrl    String?
  media       Media[]
  techTags    Tag[]     @relation("ProjectTechTags")
  qualTags    Tag[]     @relation("ProjectQualTags")
  translations ProjectTranslation[]
}

model ProjectTranslation {
  id          String   @id @default(cuid())
  locale      Locale
  name        String
  description String
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String

  @@unique([projectId, locale])
}

/* ---------------- MEDIA ---------------- */

model Media {
  id        String   @id @default(cuid())
  mediaUrl  String
  type      MediaType
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

/* ---------------- TAGS ---------------- */

model Tag {
  id             String        @id @default(cuid())
  type           TagType
  isVisible      Boolean
  hexColor       String
  projectsAsTech Project[]     @relation("ProjectTechTags")
  projectsAsQual Project[]     @relation("ProjectQualTags")
  skills         Skill[]       @relation("SkillTags")
  experiences    Experience[]  @relation("ExperienceTags")
  translations   TagTranslation[]
}

model TagTranslation {
  id      String @id @default(cuid())
  locale  Locale
  name    String
  tag     Tag    @relation(fields: [tagId], references: [id])
  tagId   String

  @@unique([tagId, locale])
}

/* ---------------- SKILLS ---------------- */

model Skill {
  id           String            @id @default(cuid())
  image        String
  wikiUrl      String?
  isVisible    Boolean
  tags         Tag[]             @relation("SkillTags")
  categories   SkillCategory[]   @relation("SkillToCategory")
  translations SkillTranslation[]
}

model SkillTranslation {
  id        String @id @default(cuid())
  locale    Locale
  name      String
  skill     Skill  @relation(fields: [skillId], references: [id])
  skillId   String

  @@unique([skillId, locale])
}

/* ---------------- SKILL CATEGORIES ---------------- */

model SkillCategory {
  id           String               @id @default(cuid())
  isVisible    Boolean
  skills       Skill[]              @relation("SkillToCategory")
  translations SkillCategoryTranslation[]
}

model SkillCategoryTranslation {
  id               String         @id @default(cuid())
  locale           Locale
  name             String
  skillCategory    SkillCategory  @relation(fields: [skillCategoryId], references: [id])
  skillCategoryId  String

  @@unique([skillCategoryId, locale])
}

/* ---------------- EXPERIENCES ---------------- */

model Experience {
  id           String       @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  contractType ContractType
  localisation String
  isVisible    Boolean
  siteUrl      String?
  tags         Tag[]        @relation("ExperienceTags")
  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  locale       Locale
  jobTitle     String
  companyName  String
  description  String
  experience   Experience @relation(fields: [experienceId], references: [id])
  experienceId String

  @@unique([experienceId, locale])
}

/* ---------------- CONTACT ---------------- */

model Contact {
  id           String               @id @default(cuid())
  contactUrl   String
  imageUrl     String
  isVisible    Boolean
  translations ContactTranslation[]
}

model ContactTranslation {
  id         String   @id @default(cuid())
  locale     Locale
  text       String
  contact    Contact  @relation(fields: [contactId], references: [id])
  contactId  String

  @@unique([contactId, locale])
}

/* ---------------- RESUME ---------------- */

model Resume {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  translations ResumeTranslation[]
}

model ResumeTranslation {
  id         String   @id @default(cuid())
  locale     Locale
  url        String
  resume     Resume   @relation(fields: [resumeId], references: [id])
  resumeId   String
}
