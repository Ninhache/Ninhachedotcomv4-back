generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TagType {
  TECH
  QUAL
  SKILL_CATEGORY
  EXPERIENCE_TECH
}

enum ContractType {
  Permanent
  Fixed
  Internship
  Workstudy
  Freelance
}

enum Locale {
  fr
  en
}

/* ---------------- USERS ---------------- */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

/* ---------------- PROJECTS ---------------- */

model Project {
  id            String               @id @default(cuid())
  startDate     DateTime
  endDate       DateTime?
  isVisible     Boolean
  gitUrl        String?
  visitUrl      String?
  playUrl       String?
  logoUrl       String?
  media         Media[]
  techTags      Tag[]                @relation("ProjectTechTags")
  qualTags      Tag[]                @relation("ProjectQualTags")
  translations  ProjectTranslation[]
}

model ProjectTranslation {
  id          String   @id @default(cuid())
  locale      Locale
  name        String
  description String
  type        String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  @@unique([projectId, locale])
}

/* ---------------- MEDIA ---------------- */

model Media {
  id           String    @id @default(cuid())
  mediaUrl     String
  type         MediaType
  originalName String?
  mimeType     String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String?
}

/* ---------------- TAGS ---------------- */

model Tag {
  id             String            @id @default(cuid())
  type           TagType
  isVisible      Boolean
  hexColor       String
  projectsAsTech Project[]         @relation("ProjectTechTags")
  projectsAsQual Project[]         @relation("ProjectQualTags")
  skills         Skill[]           @relation("SkillTags")
  experiences    Experience[]      @relation("ExperienceTags")
  translations   TagTranslation[]
}

model TagTranslation {
  id      String @id @default(cuid())
  locale  Locale
  name    String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId   String

  @@unique([tagId, locale])
}

/* ---------------- SKILLS ---------------- */

model Skill {
  id           String            @id @default(cuid())
  image        String
  wikiUrl      String?
  isVisible    Boolean
  tags         Tag[]             @relation("SkillTags")
  categories   SkillCategory[]   @relation("SkillToCategory")
  translations SkillTranslation[]
}

model SkillTranslation {
  id        String @id @default(cuid())
  locale    Locale
  name      String
  skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   String

  @@unique([skillId, locale])
}

/* ---------------- SKILL CATEGORIES ---------------- */

model SkillCategory {
  id           String                     @id @default(cuid())
  isVisible    Boolean
  skills       Skill[]                    @relation("SkillToCategory")
  translations SkillCategoryTranslation[]
}

model SkillCategoryTranslation {
  id               String        @id @default(cuid())
  locale           Locale
  name             String
  skillCategory    SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  skillCategoryId  String

  @@unique([skillCategoryId, locale])
}

/* ---------------- EXPERIENCES ---------------- */

model Experience {
  id           String       @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  contractType ContractType
  localisation String
  isVisible    Boolean
  siteUrl      String?
  imageUrl     String?
  order        Int          @default(0)
  tags         Tag[]        @relation("ExperienceTags")
  translations ExperienceTranslation[]
  companyName  String
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  locale       Locale
  jobTitle     String
  description  String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  experienceId String

  @@unique([experienceId, locale])
}

/* ---------------- CONTACT ---------------- */

model Contact {
  id           String               @id @default(cuid())
  contactUrl   String
  imageUrl     String
  isVisible    Boolean
  cssSize      String?
  translations ContactTranslation[]
}

model ContactTranslation {
  id         String   @id @default(cuid())
  locale     Locale
  name       String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String

  @@unique([contactId, locale])
}

/* ---------------- PROFILE ---------------- */

model Profile {
  id           String               @id @default(cuid())
  name         String               @default("")
  updatedAt    DateTime             @updatedAt
  translations ProfileTranslation[]
}

model ProfileTranslation {
  id          String  @id @default(cuid())
  locale      Locale
  greeting    String  @default("")
  profession  String  @default("")
  description String  @default("")
  skillsTitle String  @default("")
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  @@unique([profileId, locale])
}

/* ---------------- RESUME ---------------- */

model Resume {
  id           String              @id @default(cuid())
  updatedAt    DateTime            @updatedAt
  translations ResumeTranslation[]
}

model ResumeTranslation {
  id       String  @id @default(cuid())
  locale   Locale
  url      String
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId String
}
