
generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id  String @id @default(cuid())
  email String @unique
  password String
  createdAt DateTime @default(now())
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String
  date        DateTime
  gitUrl      String?
  visitUrl    String?
  media       Media[]
  techTags    Tag[]     @relation("ProjectTechTags")
  qualTags    Tag[]     @relation("ProjectQualTags")
}

model Media {
  id        String   @id @default(cuid())
  url       String
  type      MediaType
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

enum MediaType {
  IMAGE
  VIDEO
}

model Tag {
  id    String   @id @default(cuid())
  name  String
  type  TagType
  projectsAsTech  Project[] @relation("ProjectTechTags")
  projectsAsQual  Project[] @relation("ProjectQualTags")
  skills          Skill[]   @relation("SkillTags")
  experiences     Experience[] @relation("ExperienceTags")
}

enum TagType {
  TECH
  QUAL
  SKILL_CATEGORY
  EXPERIENCE_TECH
}

model Skill {
  id      String   @id @default(cuid())
  name    String
  image   String
  wikiUrl String?
  tags    Tag[]    @relation("SkillTags")
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  companyName String
  description String
  date        DateTime
  siteUrl     String?
  tags        Tag[]    @relation("ExperienceTags")
}

model Contact {
  id    String   @id @default(cuid())
  image String
  url   String
  text  String
}

model Resume {
  id  String @id @default(cuid())
  url String
  updatedAt DateTime @updatedAt
}

